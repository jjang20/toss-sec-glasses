# Copy to server/.env and fill in. NEVER commit the real file.
# Load it with:  node --env-file=.env src/index.ts

# mock = fake prices, fake orders, no keys needed (default)
# live = real Toss Securities account
APP_MODE=mock
PORT=8787

# Shared secret between the glasses and this server (required in live mode, >= 24 chars).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Then open the app once as  https://<host>/#pair=<DEVICE_TOKEN>
DEVICE_TOKEN=

# Toss Securities Open API — issue in 토스증권 WTS → 설정 → Open API.
# Register THIS server's public IP in the allow-list there.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
# Optional: pin an account (accountSeq from GET /api/v1/accounts). Default: first BROKERAGE.
TOSS_ACCOUNT_SEQ=

# Real-money orders are refused unless this is exactly "true".
TRADING_ENABLED=false
# Hard per-order ceiling in KRW (USD orders converted at the Toss reference FX rate).
MAX_ORDER_KRW=1000000

# Optional news (Naver Search API). Without these, mock headlines are shown.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Home-screen watchlist (KR 6-digit codes or US tickers)
WATCHLIST=005930,000660,035420,AAPL,NVDA,TSLA

# Serve the built glasses app from this server (one origin = no CORS). e.g. ../glasses/dist
STATIC_DIR=
